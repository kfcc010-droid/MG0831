<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>새마을금고 사회공헌활동(MG ESG) 관리 시스템</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans KR"', 'sans-serif'],
                    },
                    colors: {
                        // 새마을금고 브랜드 컬러 가이드
                        'mg-blue': '#0071BC', // PANTONE 3005C
                        'mg-light-blue': '#41C7F4', // PANTONE 298C
                        'mg-dark-blue': '#0B386A',
                        'mg-gray-light': '#F3F4F6',
                        'mg-green': '#10B981', // 그린MG 보조 컬러
                        'mg-orange': '#F59E0B', // 휴먼MG 보조 컬러
                        'mg-purple': '#8B5CF6', // 소셜MG 보조 컬러
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f8fafc;
            color: #334155;
        }
        
        /* 커스텀 스크롤바 */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }

        /* 입력 필드 포커스 효과 */
        .input-focus-ring:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(65, 199, 244, 0.4);
            border-color: #0071BC;
        }

        /* 라디오 버튼 커스텀 */
        .category-radio:checked + label {
            border-color: #0071BC;
            background-color: #eff6ff;
            font-weight: bold;
        }
        
        #green-mg:checked + label { border-color: #10B981; background-color: #ecfdf5; color: #047857; }
        #social-mg:checked + label { border-color: #8B5CF6; background-color: #f5f3ff; color: #5b21b6; }
        #human-mg:checked + label { border-color: #F59E0B; background-color: #fffbeb; color: #b45309; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        /* 트랜지션 */
        .btn-transition {
            transition: all 0.2s ease-in-out;
        }
        
        .fade-in {
            animation: fadeIn 0.3s ease-in;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans">
    
    <!-- Header -->
    <header class="bg-mg-blue text-white shadow-md relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 pointer-events-none">
             <i class="fa-solid fa-leaf text-9xl transform -translate-y-4 translate-x-4"></i>
        </div>
        <div class="container mx-auto px-4 py-5 flex items-center justify-between relative z-10">
            <div class="flex items-center gap-3">
                <!-- 가상의 로고 아이콘 -->
                <div class="bg-white p-2 rounded-lg flex items-center justify-center">
                    <span class="text-mg-blue font-black text-xl leading-none">MG</span>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold tracking-tight">사회공헌활동(ESG) 통합 관리</h1>
                    <p class="text-mg-light-blue text-xs md:text-sm font-medium">지역사회와 함께 성장하는 새마을금고</p>
                </div>
            </div>
            <div class="hidden md:flex gap-4 text-sm font-medium opacity-80">
                <span class="flex items-center gap-1"><i class="fa-solid fa-seedling"></i> 그린MG</span>
                <span class="flex items-center gap-1"><i class="fa-solid fa-people-arrows"></i> 소셜MG</span>
                <span class="flex items-center gap-1"><i class="fa-solid fa-hand-holding-heart"></i> 휴먼MG</span>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-8 max-w-6xl flex flex-col lg:flex-row gap-8">
        
        <!-- Left Column: Input Form -->
        <section class="w-full lg:w-5/12 xl:w-1/2">
            <div class="glass-panel rounded-2xl shadow-sm p-6 md:p-8 h-full">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-2 border-b pb-4">
                    <i class="fa-solid fa-pen-to-square text-mg-light-blue"></i>
                    활동 내역 등록
                </h2>

                <form id="esgForm" class="space-y-6">
                    
                    <!-- 1. 카테고리 선택 -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-3">사회공헌 분야 선택</label>
                        <div class="grid grid-cols-3 gap-3">
                            <div class="relative">
                                <input type="radio" name="category" id="green-mg" value="green" class="hidden category-radio" checked>
                                <label for="green-mg" class="flex flex-col items-center justify-center p-3 border-2 border-gray-200 rounded-xl cursor-pointer btn-transition hover:bg-gray-50 text-center h-full">
                                    <i class="fa-solid fa-leaf text-2xl text-emerald-500 mb-2"></i>
                                    <span class="font-semibold text-sm">그린MG</span>
                                    <span class="text-[10px] text-gray-500 mt-1 hidden md:block">환경보호/녹색성장</span>
                                </label>
                            </div>
                            <div class="relative">
                                <input type="radio" name="category" id="social-mg" value="social" class="hidden category-radio">
                                <label for="social-mg" class="flex flex-col items-center justify-center p-3 border-2 border-gray-200 rounded-xl cursor-pointer btn-transition hover:bg-gray-50 text-center h-full">
                                    <i class="fa-solid fa-people-arrows text-2xl text-violet-500 mb-2"></i>
                                    <span class="font-semibold text-sm">소셜MG</span>
                                    <span class="text-[10px] text-gray-500 mt-1 hidden md:block">지역상권/청년기업</span>
                                </label>
                            </div>
                            <div class="relative">
                                <input type="radio" name="category" id="human-mg" value="human" class="hidden category-radio">
                                <label for="human-mg" class="flex flex-col items-center justify-center p-3 border-2 border-gray-200 rounded-xl cursor-pointer btn-transition hover:bg-gray-50 text-center h-full">
                                    <i class="fa-solid fa-hand-holding-heart text-2xl text-amber-500 mb-2"></i>
                                    <span class="font-semibold text-sm">휴먼MG</span>
                                    <span class="text-[10px] text-gray-500 mt-1 hidden md:block">배려계층 지원</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- 2. 기간 선택 -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2" for="activityDate">활동 일자</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-regular fa-calendar text-gray-400"></i>
                            </div>
                            <input type="date" id="activityDate" required
                                class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl input-focus-ring text-gray-700 bg-white"
                                placeholder="YYYY-MM-DD">
                        </div>
                    </div>

                    <!-- 3. 활동명 -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2" for="activityName">활동 내역 (선택)</label>
                        <input type="text" id="activityName" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl input-focus-ring text-gray-700 bg-white"
                            placeholder="예: 걷기 좋은 날 캠페인, 사랑의 좀도리 운동 등">
                    </div>

                    <!-- 4. 금액 입력 -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2" for="amount">지원 금액 (단위: 만원)</label>
                        <div class="relative mb-3">
                            <input type="number" id="amount" required min="0" step="1"
                                class="w-full px-4 py-4 border border-gray-300 rounded-xl input-focus-ring text-gray-800 text-lg font-bold bg-white text-right pr-12"
                                placeholder="0">
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <span class="text-gray-500 font-bold">만원</span>
                            </div>
                        </div>
                        
                        <!-- 원터치 입력 버튼 -->
                        <div class="flex flex-wrap gap-2">
                            <button type="button" onclick="addAmount(1)" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-3 rounded-lg text-sm border border-gray-200 btn-transition">
                                + 1만원
                            </button>
                            <button type="button" onclick="addAmount(10)" class="flex-1 bg-blue-50 hover:bg-blue-100 text-mg-blue font-medium py-2 px-3 rounded-lg text-sm border border-blue-200 btn-transition">
                                + 10만원
                            </button>
                            <button type="button" onclick="addAmount(50)" class="flex-1 bg-blue-100 hover:bg-blue-200 text-mg-blue font-bold py-2 px-3 rounded-lg text-sm border border-blue-300 btn-transition">
                                + 50만원
                            </button>
                            <button type="button" onclick="addAmount(100)" class="flex-1 bg-mg-light-blue hover:bg-mg-blue hover:text-white text-mg-dark-blue font-bold py-2 px-3 rounded-lg text-sm border border-mg-light-blue btn-transition">
                                + 100만원
                            </button>
                            <button type="button" onclick="clearAmount()" class="bg-red-50 hover:bg-red-100 text-red-600 font-medium py-2 px-3 rounded-lg text-sm border border-red-200 btn-transition" title="금액 초기화">
                                <i class="fa-solid fa-rotate-left"></i>
                            </button>
                        </div>
                    </div>

                    <!-- 제출 버튼 -->
                    <button type="submit" class="w-full bg-mg-blue hover:bg-mg-dark-blue text-white font-bold text-lg py-4 px-6 rounded-xl shadow-md btn-transition flex items-center justify-center gap-2 mt-4">
                        <i class="fa-solid fa-plus"></i>
                        내역 등록하기
                    </button>
                </form>
            </div>
        </section>

        <!-- Right Column: Results & Statistics -->
        <section class="w-full lg:w-7/12 xl:w-1/2 flex flex-col gap-6">
            
            <!-- 연도별 요약 대시보드 -->
            <div class="glass-panel rounded-2xl shadow-sm p-6">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-mg-blue"></i>
                        연도별 ESG 활동 현황
                    </h2>
                    <select id="yearSelector" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-mg-blue focus:border-mg-blue block p-2.5 font-bold">
                        <option value="all">전체 연도</option>
                        <!-- JS에서 동적으로 연도 옵션 추가 -->
                    </select>
                </div>

                <!-- 총합 요약 카드 -->
                <div class="bg-gradient-to-br from-mg-blue to-mg-dark-blue rounded-xl p-6 text-white shadow-inner mb-6 relative overflow-hidden">
                    <div class="absolute right-[-20px] top-[-20px] opacity-10">
                        <i class="fa-solid fa-won-sign text-9xl"></i>
                    </div>
                    <p class="text-mg-light-blue font-medium mb-1 text-sm">선택 연도 총 지원 금액</p>
                    <div class="flex items-end gap-2 relative z-10">
                        <span id="totalAmountDisplay" class="text-4xl md:text-5xl font-black tracking-tight">0</span>
                        <span class="text-xl mb-1 font-bold">만원</span>
                    </div>
                </div>

                <!-- 분야별 요약 (Progress Bars) -->
                <div class="space-y-4">
                    <!-- 그린MG -->
                    <div>
                        <div class="flex justify-between text-sm font-bold mb-1">
                            <span class="text-emerald-700 flex items-center gap-1"><i class="fa-solid fa-leaf"></i> 그린MG</span>
                            <span id="greenTotalDisplay">0 만원</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                            <div id="greenBar" class="bg-emerald-500 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                    </div>
                    <!-- 소셜MG -->
                    <div>
                        <div class="flex justify-between text-sm font-bold mb-1">
                            <span class="text-violet-700 flex items-center gap-1"><i class="fa-solid fa-people-arrows"></i> 소셜MG</span>
                            <span id="socialTotalDisplay">0 만원</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                            <div id="socialBar" class="bg-violet-500 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                    </div>
                    <!-- 휴먼MG -->
                    <div>
                        <div class="flex justify-between text-sm font-bold mb-1">
                            <span class="text-amber-700 flex items-center gap-1"><i class="fa-solid fa-hand-holding-heart"></i> 휴먼MG</span>
                            <span id="humanTotalDisplay">0 만원</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                            <div id="humanBar" class="bg-amber-500 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 상세 리스트 -->
            <div class="glass-panel rounded-2xl shadow-sm p-6 flex-grow flex flex-col">
                <div class="flex justify-between items-center mb-4 border-b pb-4">
                    <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-list-ul text-gray-500"></i>
                        상세 내역
                    </h2>
                    <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">최신순</span>
                </div>
                
                <div class="overflow-y-auto max-h-[300px] flex-grow pr-2" id="historyList">
                    <!-- JS에서 동적으로 리스트 항목 생성 -->
                    <div class="text-center py-10 text-gray-400 text-sm flex flex-col items-center gap-2">
                        <i class="fa-regular fa-folder-open text-3xl"></i>
                        등록된 활동 내역이 없습니다.
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t py-6 mt-auto">
        <div class="container mx-auto px-4 text-center text-sm text-gray-500">
            <p>MG새마을금고 사회공헌활동(ESG) 통합 관리 시스템</p>
            <p class="mt-1 text-xs">© MG Community Credit Cooperatives. All rights reserved.</p>
        </div>
    </footer>

    <!-- 알림 메시지 (토스트) -->
    <div id="toast" class="fixed bottom-5 right-5 bg-gray-800 text-white px-6 py-3 rounded-lg shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center gap-3 font-medium">
        <i class="fa-solid fa-circle-check text-mg-light-blue text-lg"></i>
        <span id="toastMsg">등록되었습니다.</span>
    </div>

    <script>
        // --- 데이터 모델 및 상태 ---
        
        // 로컬 스토리지 키
        const STORAGE_KEY = 'mg_esg_records';
        
        // 기록을 담을 배열 (초기 데이터로 2025, 2026년 가짜 데이터 약간 포함)
        let records = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [
            { id: 1, date: '2026-03-15', year: '2026', category: 'green', name: '걷기 좋은 날 캠페인', amount: 500 },
            { id: 2, date: '2026-02-10', year: '2026', category: 'human', name: '사랑의 좀도리 운동', amount: 1500 },
            { id: 3, date: '2025-11-20', year: '2025', category: 'social', name: '청년기업 판로 지원', amount: 3000 },
            { id: 4, date: '2025-05-08', year: '2025', category: 'human', name: '어버이날 경로당 지원', amount: 200 }
        ];

        // 카테고리 정보 매핑
        const catInfo = {
            'green': { name: '그린MG', colorClass: 'text-emerald-600', bgClass: 'bg-emerald-50', icon: 'fa-leaf' },
            'social': { name: '소셜MG', colorClass: 'text-violet-600', bgClass: 'bg-violet-50', icon: 'fa-people-arrows' },
            'human': { name: '휴먼MG', colorClass: 'text-amber-600', bgClass: 'bg-amber-50', icon: 'fa-hand-holding-heart' }
        };

        // --- DOM 요소 참조 ---
        const form = document.getElementById('esgForm');
        const amountInput = document.getElementById('amount');
        const dateInput = document.getElementById('activityDate');
        const nameInput = document.getElementById('activityName');
        const yearSelector = document.getElementById('yearSelector');
        const historyList = document.getElementById('historyList');
        
        // 요약 디스플레이 참조
        const totalDisplay = document.getElementById('totalAmountDisplay');
        const greenTotal = document.getElementById('greenTotalDisplay');
        const socialTotal = document.getElementById('socialTotalDisplay');
        const humanTotal = document.getElementById('humanTotalDisplay');
        const greenBar = document.getElementById('greenBar');
        const socialBar = document.getElementById('socialBar');
        const humanBar = document.getElementById('humanBar');
        const toast = document.getElementById('toast');

        // --- 초기화 로직 ---
        function init() {
            // 오늘 날짜를 기본값으로 설정
            const today = new Date().toISOString().split('T')[0];
            dateInput.value = today;

            updateYearSelector();
            renderDashboard();
        }

        // --- 이벤트 리스너 ---
        
        // 폼 제출 이벤트
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const selectedCategory = document.querySelector('input[name="category"]:checked').value;
            const dateVal = dateInput.value;
            const amountVal = parseInt(amountInput.value, 10);
            let nameVal = nameInput.value.trim();
            
            if (!dateVal || isNaN(amountVal) || amountVal <= 0) {
                showToast('올바른 날짜와 금액을 입력해주세요.', true);
                return;
            }

            if(!nameVal) {
                nameVal = catInfo[selectedCategory].name + ' 활동';
            }

            const yearVal = dateVal.split('-')[0];

            const newRecord = {
                id: Date.now(), // 고유 ID
                date: dateVal,
                year: yearVal,
                category: selectedCategory,
                name: nameVal,
                amount: amountVal
            };

            // 데이터 추가 및 저장
            records.unshift(newRecord); // 최신순으로 배열 앞에 추가
            saveData();
            
            // 폼 초기화 (날짜, 카테고리는 유지)
            amountInput.value = '';
            nameInput.value = '';
            
            // UI 업데이트
            updateYearSelector();
            
            // 방금 추가한 연도로 셀렉터 변경 시도
            if(yearSelector.value !== 'all' && yearSelector.value !== yearVal) {
                 yearSelector.value = yearVal;
            }

            renderDashboard();
            showToast('내역이 성공적으로 등록되었습니다.');
        });

        // 연도 필터 변경 이벤트
        yearSelector.addEventListener('change', renderDashboard);

        // --- 헬퍼 함수 ---

        // 원터치 금액 버튼 로직
        window.addAmount = function(val) {
            const current = parseInt(amountInput.value) || 0;
            amountInput.value = current + val;
            // 포커스 이동하여 시각적 피드백
            amountInput.focus();
        };

        window.clearAmount = function() {
            amountInput.value = '';
            amountInput.focus();
        }

        window.deleteRecord = function(id) {
            if(confirm('이 내역을 삭제하시겠습니까?')) {
                records = records.filter(r => r.id !== id);
                saveData();
                updateYearSelector(); // 연도가 사라졌을 수 있으므로 업데이트
                renderDashboard();
                showToast('삭제되었습니다.');
            }
        }

        function saveData() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
        }

        function showToast(msg, isError = false) {
            const toastMsg = document.getElementById('toastMsg');
            const icon = toast.querySelector('i');
            
            toastMsg.textContent = msg;
            
            if(isError) {
                toast.classList.replace('bg-gray-800', 'bg-red-600');
                icon.className = 'fa-solid fa-circle-exclamation text-white text-lg';
            } else {
                toast.classList.replace('bg-red-600', 'bg-gray-800');
                icon.className = 'fa-solid fa-circle-check text-mg-light-blue text-lg';
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // 숫자에 콤마 찍기
        function formatNumber(num) {
            return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        // --- UI 업데이트 함수 ---

        // 연도 셀렉터 옵션 업데이트
        function updateYearSelector() {
            const currentSelected = yearSelector.value;
            
            // 존재하는 연도 추출 및 정렬 (내림차순)
            const years = [...new Set(records.map(r => r.year))].sort().reverse();
            
            // 셀렉터 초기화 (기본 옵션 제외)
            yearSelector.innerHTML = '<option value="all">전체 연도</option>';
            
            years.forEach(year => {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = `${year}년`;
                yearSelector.appendChild(option);
            });

            // 이전에 선택된 연도가 목록에 있으면 유지, 없으면 'all'
            if (years.includes(currentSelected)) {
                yearSelector.value = currentSelected;
            } else {
                yearSelector.value = 'all';
            }
        }

        // 대시보드 및 리스트 렌더링
        function renderDashboard() {
            const selectedYear = yearSelector.value;
            
            // 필터링된 데이터
            const filteredRecords = selectedYear === 'all' 
                ? records 
                : records.filter(r => r.year === selectedYear);
            
            // 합계 계산
            let totals = { total: 0, green: 0, social: 0, human: 0 };
            
            filteredRecords.forEach(r => {
                totals.total += r.amount;
                if (totals[r.category] !== undefined) {
                    totals[r.category] += r.amount;
                }
            });

            // 애니메이션을 위해 카운트업 효과 적용 (간단한 버전)
            totalDisplay.textContent = formatNumber(totals.total);
            
            greenTotal.textContent = formatNumber(totals.green) + ' 만원';
            socialTotal.textContent = formatNumber(totals.social) + ' 만원';
            humanTotal.textContent = formatNumber(totals.human) + ' 만원';

            // 프로그레스 바 너비 계산
            const calcPercent = (val, total) => total > 0 ? (val / total) * 100 : 0;
            
            // 약간의 딜레이를 주어 CSS 트랜지션이 작동하도록 함
            setTimeout(() => {
                greenBar.style.width = `${calcPercent(totals.green, totals.total)}%`;
                socialBar.style.width = `${calcPercent(totals.social, totals.total)}%`;
                humanBar.style.width = `${calcPercent(totals.human, totals.total)}%`;
            }, 50);

            // 리스트 렌더링
            renderList(filteredRecords);
        }

        // 상세 내역 리스트 렌더링
        function renderList(listData) {
            if (listData.length === 0) {
                historyList.innerHTML = `
                    <div class="text-center py-10 text-gray-400 text-sm flex flex-col items-center gap-2">
                        <i class="fa-regular fa-folder-open text-3xl"></i>
                        해당 기간에 등록된 활동 내역이 없습니다.
                    </div>
                `;
                return;
            }

            // 날짜 최신순 정렬
            const sortedList = [...listData].sort((a, b) => new Date(b.date) - new Date(a.date));

            let html = '<div class="space-y-3">';
            
            sortedList.forEach((r, index) => {
                const info = catInfo[r.category];
                // staggered animation
                const animDelay = index < 5 ? `style="animation-delay: ${index * 0.05}s;"` : '';
                
                html += `
                    <div class="flex items-center justify-between p-3 rounded-lg border border-gray-100 hover:bg-gray-50 transition-colors bg-white fade-in shadow-sm" ${animDelay}>
                        <div class="flex items-center gap-3 overflow-hidden">
                            <div class="w-10 h-10 rounded-full ${info.bgClass} flex items-center justify-center shrink-0">
                                <i class="fa-solid ${info.icon} ${info.colorClass}"></i>
                            </div>
                            <div class="truncate pr-2">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs font-bold px-2 py-0.5 rounded bg-gray-100 ${info.colorClass}">${info.name}</span>
                                    <span class="text-xs text-gray-500"><i class="fa-regular fa-calendar mr-1"></i>${r.date}</span>
                                </div>
                                <p class="text-sm font-medium text-gray-800 truncate">${r.name}</p>
                            </div>
                        </div>
                        <div class="text-right shrink-0 flex flex-col items-end gap-1">
                            <span class="font-bold text-gray-900">${formatNumber(r.amount)}<span class="text-xs font-normal text-gray-500 ml-0.5">만원</span></span>
                            <button onclick="deleteRecord(${r.id})" class="text-[10px] text-gray-400 hover:text-red-500 transition-colors">삭제</button>
                        </div>
                    </div>
                `;
            });
            
            html += '</div>';
            historyList.innerHTML = html;
        }

        // 앱 시작
        document.addEventListener('DOMContentLoaded', init);

    </script>
</body>
</html>
